               <children>
                  <Label alignment="CENTER" contentDisplay="BOTTOM" graphicTextGap="0.0" maxWidth="1.7976931348623157E308" prefHeight="96.0" prefWidth="342.0" style="-fx-font-size: 30px; -fx-font-family: 'TW Cen MT Bold'; -fx-font-weight: bold;" text="Queen Game Solver" textFill="WHITE" wrapText="true">
