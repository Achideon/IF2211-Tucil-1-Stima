               <children>
                  <Button fx:id="btnStart" mnemonicParsing="false" onAction="#startButton" prefHeight="43.0" prefWidth="241.0" styleClass="menu-btn" stylesheets="@../css/button.css" text="SELECT BOARD" textFill="#a2ffcd" textOverrun="CLIP" wrapText="true" />
